rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function donoDoPerfil(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    match /Clientes/{uid} {
      allow read, create, update, delete: if donoDoPerfil(uid);
    }

    match /Profissionais/{uid} {
      allow read: if autenticado();
      allow create, update, delete: if donoDoPerfil(uid);
    }

    match /Servicos/{id} {
      allow read: if autenticado();
      allow create: if autenticado() &&
        request.resource.data.profissionalId == request.auth.uid;
      allow update, delete: if autenticado() &&
        resource.data.profissionalId == request.auth.uid;
    }

    match /Pedidos/{id} {
      allow create: if autenticado() &&
        request.resource.data.clienteId == request.auth.uid;

      allow read: if autenticado() &&
        (resource.data.clienteId == request.auth.uid ||
         resource.data.profissionalId == request.auth.uid);

      allow update: if autenticado() && (
        (
          resource.data.profissionalId == request.auth.uid &&
          request.resource.data.clienteId == resource.data.clienteId &&
          request.resource.data.profissionalId == resource.data.profissionalId &&
          request.resource.data.servicoId == resource.data.servicoId &&
          request.resource.data.status in ['aguardando', 'confirmado', 'cancelado', 'concluido']
        ) ||
        (
          resource.data.clienteId == request.auth.uid &&
          request.resource.data.clienteId == resource.data.clienteId &&
          request.resource.data.profissionalId == resource.data.profissionalId &&
          request.resource.data.servicoId == resource.data.servicoId &&
          request.resource.data.status == 'cancelado'
        )
      );

      allow delete: if autenticado() &&
        resource.data.clienteId == request.auth.uid;
    }
  }
}
